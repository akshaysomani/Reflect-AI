# =========================================================
# Reflect-AI Environment Configuration Reference
# =========================================================

# 1. Gemini API Configuration (Backend Only)
# Production: Injected securely via Google Cloud Secret Manager to Cloud Run.
# Development: Place your Gemini API key here for local testing.
# NEVER commit your actual API key to version control or expose it to Vite/frontend.
GEMINI_API_KEY=""

# 2. Server Port & Network Binding
# Cloud Run automatically sets the PORT environment variable.
# Local default is 3000.
PORT=3000

# 3. CORS Allowed Frontend Origins
# Comma-separated list of allowed origins.
# Development: http://localhost:5173,http://localhost:3000
# Production: https://reflect-ai-xi-three.vercel.app
FRONTEND_URL="http://localhost:5173,http://localhost:3000,https://reflect-ai-xi-three.vercel.app"

# 4. Frontend API Base URL (Vite Environment Variable)
# Development (when running separate frontend and backend):
VITE_API_BASE_URL=http://localhost:3000
# Production (set this in your Vercel Project Settings > Environment Variables):
# VITE_API_BASE_URL=https://<YOUR-CLOUD-RUN-SERVICE-URL>  (e.g., https://reflect-ai-backend-xxxxxx-uc.a.run.app - DO NOT ADD /api AT THE END)

# 5. Firebase Configuration (Optional override - defaults provided in code)
FIREBASE_PROJECT_ID="gen-ai-cohort-3-defb5"
VITE_FIREBASE_API_KEY="AIzaSyD7tO2MSUvsZdS0jSBDnYkzDracg3RgyvE"
VITE_FIREBASE_AUTH_DOMAIN="gen-ai-cohort-3-defb5.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-ai-cohort-3-defb5"
VITE_FIREBASE_STORAGE_BUCKET="gen-ai-cohort-3-defb5.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="243350167608"
VITE_FIREBASE_APP_ID="1:243350167608:web:c6134ad0441e7e5e2386cd"
VITE_FIREBASE_MEASUREMENT_ID="G-1RXSZJ0D3P"
